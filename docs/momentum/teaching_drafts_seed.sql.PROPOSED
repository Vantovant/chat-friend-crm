-- PROPOSED (13 Nov 2026) - NOT APPLIED. Creates the seven teachings as DRAFTS (nothing approved, scheduled or sent).
-- Generated from docs/momentum/teaching_drafts_manifest.json. RUN ONLY AFTER: Phase A+B/C+D migrations are applied AND the source articles have been pushed
-- (gwa_article_push.sql.PROPOSED backfill) so momentum_source_articles holds them. draft_teaching_from_source() refuses any quote that is not
-- character-for-character in the stored article, so a wrong or altered line makes the statement fail instead of creating a draft.
-- Each teaching can only be created once per run: re-running creates a second draft of the same text, so check first:
--   select title, status from content_items where kind='teaching';
begin;
select public.draft_teaching_from_source('hero-trap-duplication', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 1 OF 7"}, {"type": "title", "text": "The Hero Trap: Why the Busiest Leader Can Hold the Team Back"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Every rescue teaches the team to wait. That is the hero trap. It starts as love, but it ends up becoming a ceiling."}, {"type": "quote", "text": "Write down three things you currently do for your team that they could do themselves without you. Then pick one and teach it this week."}, {"type": "quote", "text": "Stop rescuing. Start teaching. Build people who build."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('4-step-duplication', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 2 OF 7"}, {"type": "title", "text": "4-Step Duplication: Show, Guide, Practise, Pass On"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Mr Baloyi gives builders four simple steps: show, guide, practise and pass on."}, {"type": "quote", "text": "Show. Do it once while they watch, and tell them why."}, {"type": "quote", "text": "Guide. They do it while you stand beside them."}, {"type": "quote", "text": "Practise. They practise alone, when you are not even there. You check afterwards."}, {"type": "quote", "text": "Pass on. They teach it to someone else and guide them."}, {"type": "quote", "text": "Take one task and one person. Show, guide, practise and pass on. This is duplication."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('simple-beats-clever', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 3 OF 7"}, {"type": "title", "text": "Simple Beats Clever: If It Can't Be Copied, It Can't Be Duplicated"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Your new person does not need clever. As Mr Baloyi puts it, they need three simple steps they can repeat on day one, even when they are nervous."}, {"type": "quote", "text": "Here is a simple test for anything you teach: can somebody who joined on Monday do it by Friday? If not, simplify it. Clever impresses people. Simple multiplies."}, {"type": "quote", "text": "If it can't be copied, it can't be duplicated. Keep it simple."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('three-skills-duplication', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 4 OF 7"}, {"type": "title", "text": "3 Skills: Stop Teaching Your New Person Everything"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Mr Baloyi's answer: instead, teach three things."}, {"type": "quote", "text": "How to invite"}, {"type": "quote", "text": "How to present"}, {"type": "quote", "text": "How to follow up"}, {"type": "quote", "text": "That's it. Everything else can wait, because three things practised beat ten things explained. Confidence comes from doing, not from listening or knowing."}, {"type": "quote", "text": "Choose one of the three and teach that one to your new person this week. Three skills, one at a time. Then they are ready for more."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('weekly-rhythm-duplication', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 5 OF 7"}, {"type": "title", "text": "Weekly Rhythm: People Duplicate What Happens Every Week"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Mr Baloyi puts it simply: people don't duplicate what you say. They duplicate what happens every week in their business."}, {"type": "quote", "text": "Teams that move forward have the same day, the same time and the same format, every week."}, {"type": "quote", "text": "Review the previous week."}, {"type": "quote", "text": "Pick one skill to focus on."}, {"type": "quote", "text": "Each person reports their numbers for the week."}, {"type": "quote", "text": "Get used to it. Then, once it works, let the next person lead the following week, because a rhythm that only you can run is just another dependency."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('without-you-duplication', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 6 OF 7"}, {"type": "title", "text": "Without You: The Best Day in Your Leadership"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Mr Baloyi says the best day in your leadership is the day they do it without you. Someone makes the call alone, runs the meeting alone, or answers the objection without you."}, {"type": "quote", "text": "Celebrate it in public."}, {"type": "quote", "text": "Then ask one question: \"What would you do differently next time?\""}, {"type": "quote", "text": "That is how confidence builds in your leaders without you. Cheer for the first time, and you will see the second time happen without you."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
select public.draft_teaching_from_source('teach-someone-to-teach', $j$[{"type": "frame", "text": "🔥 A-TEAM DUPLICATION — TEACHING 7 OF 7"}, {"type": "title", "text": "Teach Someone to Teach: How a Business Grows Through People"}, {"type": "quote", "text": "A teaching by Mr Masiya Baloyi"}, {"type": "quote", "text": "Mr Baloyi closes the series with this: your business starts to grow fast when your people can teach, not only when they can do. Doing is one person at a time. Teaching is more people through more people."}, {"type": "quote", "text": "Ask each person: \"Who will you teach this to?\""}, {"type": "quote", "text": "Someone with no one to teach has not yet learned enough. When a person teaches another person, they understand it in a way that listening alone never gives them."}, {"type": "quote", "text": "Build people who will build your business."}, {"type": "frame", "text": "🔥 We learn. We practise. We teach. We duplicate."}]$j$::jsonb, 'vanto-approved-draft-run');
commit;
